# ============================================================
#  Wall Mould UV Grading — on-premises configuration
#  Copy to .env and edit: cp .env.example .env
# ============================================================

# ---------- Multimodal model (OpenAI-compatible /v1/chat/completions) ----------
# Local server options include vLLM, SGLang, Ollama, and Xinference.
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen3.6-35b-a3b
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
# Set to false to extract JSON from text if response_format is unsupported.
LLM_JSON_MODE=true

# ---------- Reference images ----------
# none   = Text-only grading criteria (fewest tokens)
# anchor = Include L1/L3/L5 UV reference images (recommended)
# full   = Include all 10 reference images (higher cost; for debugging)
REFERENCE_MODE=anchor
REFERENCE_DIR=./reference
REFERENCE_MAX_EDGE=512

# ---------- Grading ----------
# llm_led = Model-led grading with CV measurements as evidence and fallback (default)
# cv_led  = CV threshold-led grading; the model only checks regions
GRADING_STRATEGY=llm_led
GRADING_CONFIG=./config/grading.yaml

# ---------- Imaging and analysis ----------
MAX_UPLOAD_MB=12
ANALYSIS_LONG_EDGE=1600
ENABLE_REGISTRATION=true
# Calibration card: ArUco DICT_4X4_50, corner IDs 0–3
ENABLE_CALIBRATION_CARD=true
CALIB_CARD_WIDTH_MM=85.6
CALIB_CARD_HEIGHT_MM=54.0

# ---------- Service ----------
APP_HOST=0.0.0.0
APP_PORT=8000
STORAGE_DIR=./data
DEFAULT_LOCALE=zh
RETENTION_DAYS=30
# Leave empty to allow all origins on a trusted local network.
CORS_ORIGINS=
