# ============================================================
#  墙面霉菌 UV 分级检测 · 私有化部署配置
#  Wall Mould UV Grading — on-premise configuration
#  复制为 .env 后修改：cp .env.example .env
# ============================================================

# ---------- 多模态大模型（OpenAI 兼容 /v1/chat/completions）----------
# 私有化部署示例：vLLM / SGLang / Ollama / Xinference 均可
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen3.6-35b-a3b
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
# 部分推理框架不支持 response_format，置 false 则改用文本 JSON 抽取
LLM_JSON_MODE=true

# ---------- 参考图锚定 ----------
# none   = 只用文字分级标准（最省 token）
# anchor = 注入 L1/L3/L5 三张 UV 参考图（推荐）
# full   = 注入全部 10 张（成本翻倍，仅调试用）
REFERENCE_MODE=anchor
REFERENCE_DIR=./reference
REFERENCE_MAX_EDGE=512

# ---------- 分级 ----------
# llm_led  = 大模型主导分级，CV 数值作为证据与兜底（默认）
# cv_led   = CV 阈值主导，大模型仅做区域校验
GRADING_STRATEGY=llm_led
GRADING_CONFIG=./config/grading.yaml

# ---------- 图像与算法 ----------
MAX_UPLOAD_MB=12
ANALYSIS_LONG_EDGE=1600
ENABLE_REGISTRATION=true
# 标定卡（ArUco DICT_4X4_50，id=0..3 四角）
ENABLE_CALIBRATION_CARD=true
CALIB_CARD_WIDTH_MM=85.6
CALIB_CARD_HEIGHT_MM=54.0

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
STORAGE_DIR=./data
DEFAULT_LOCALE=zh
RETENTION_DAYS=30
# 私有化环境通常内网直连，留空表示允许所有来源
CORS_ORIGINS=
